                 {
                     "name":  "00 Login admin - guardar JWT",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\"Login admin: HTTP 200\", function () {",
                                                                   "    pm.response.to.have.status(200);",
                                                                   "});",
                                                                   "",
                                                                   "const data = pm.response.json();\npm.test(\"Token JWT disponible\", function () { pm.expect(data.token).to.be.a(\"string\").and.not.empty; });\nif (pm.response.code === 200 \u0026\u0026 data.token) { pm.collectionVariables.set(\"adminToken\", data.token); }"
                                                               ]
                                                  }
                                   }
                               ],
